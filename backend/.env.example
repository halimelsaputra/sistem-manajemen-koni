# =====================================================================
# SI-KONI Aceh — Backend Environment Variables
# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN pernah mengisi nilai asli di file ini — hanya placeholder.
# =====================================================================

# Supabase (project URL + service role key — isi dari Supabase Dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Secret untuk menandatangani & memverifikasi token sesi.
# WAJIB identik dengan frontend/.env AUTH_SECRET.
# Gunakan string acak yang panjang, contoh: openssl rand -hex 32
AUTH_SECRET=openssl-rand-hex-32-output-here

# Kredensial super admin (login halaman /login).
# Backward compatible — akun super admin tetap di sini, bukan di database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# (Opsional) Admin wilayah disimpan di tabel `admin_users` Supabase
# (lihat migrasi 010_create_admin_users.sql) — tidak perlu env tambahan.
