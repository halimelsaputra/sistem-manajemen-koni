# =====================================================================
# SI-KONI Aceh — Backend Environment Variables
# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN pernah mengisi nilai asli di file ini — hanya placeholder.
# =====================================================================

# Supabase (project URL + service role key — isi dari Supabase Dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Nilai token sesi yang divalidasi oleh backend/middleware.ts
# WAJIB identik dengan frontend/.env AUTH_TOKEN_VALUE.
# Gunakan string acak yang panjang, contoh: openssl rand -hex 32
# (jangan dibiarkan bernilai 'authenticated' di lingkungan produksi)
AUTH_TOKEN_VALUE=openssl-rand-hex-32-output-here

# Kredensial admin (login halaman /login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat
