# =====================================================================
# SI-KONI Aceh — Frontend Environment Variables
# Salin file ini menjadi `.env` lalu isi nilainya.
# JANGAN pernah mengisi nilai asli di file ini — hanya placeholder.
# =====================================================================

# URL backend (hanya wajib di produksi/deploy, mis. Vercel).
# Di lokal tidak perlu diisi — otomatis pakai http://localhost:3001
# Contoh produksi: https://koni-backend.vercel.app
BACKEND_URL=

# Kredensial admin (login halaman /login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Nilai token sesi yang divalidasi oleh middleware.ts
# WAJIB identik dengan backend/.env AUTH_TOKEN_VALUE.
# Gunakan string acak yang panjang, contoh: openssl rand -hex 32
AUTH_TOKEN_VALUE=openssl-rand-hex-32-output-here
